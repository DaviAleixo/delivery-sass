{
  "name": "pedemuleke-spooler",
  "version": "1.0.0",
  "description": "Mini Spooler Local de Impressão Térmica Automática para PedeMuleke",
  "main": "server.js",
  "type": "module",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output pedemuleke-spooler.exe"
  },
  "pkg": {
    "scripts": [
      "printerService.js",
      "ticketFormatter.js"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "delivery",
    "spooler",
    "printer",
    "thermal",
    "pos"
  ],
  "author": "PedeMuleke",
  "license": "ISC"
}
