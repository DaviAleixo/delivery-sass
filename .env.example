# ==========================================
# CONFIGURAÇÃO DO SUPABASE (PEDEMULEKE)
# ==========================================
# Produção: Project Settings -> API -> Project URL & Project API Keys (anon public)
# Homologação/Staging: Chaves do projeto 'pedemuleke-staging' ou tenant de teste
VITE_SUPABASE_URL=https://sua-url-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=seu-token-anon-public-supabase

# ==========================================
# CONFIGURAÇÃO DO SENTRY (OBSERVABILIDADE)
# ==========================================
VITE_SENTRY_DSN=https://sua-chave-sentry.ingest.sentry.io/seu-projeto

# ==========================================
# AMBIENTE DA APLICAÇÃO
# ==========================================
# Valores permitidos: production | staging | development
VITE_APP_ENV=development

